<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - Aurora Hotel</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body data-page="@(ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "dashboard")"><div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">A</span><span>Aurora<br /><small>Hotel manager</small></span></a><nav><a class="nav-link role-menu-item active" data-roles="customer receptionist housekeeping accountant manager admin" asp-controller="Dashboard" asp-action="Index">Tổng quan</a><span class="nav-label">VẬN HÀNH</span><a class="nav-link role-menu-item" data-roles="receptionist housekeeping manager admin" href="#">Phòng và đặt phòng</a><a class="nav-link role-menu-item" data-roles="customer receptionist manager admin" href="#">Khách hàng</a><a class="nav-link role-menu-item" data-roles="receptionist manager admin" href="#">Đặt phòng</a><a class="nav-link role-menu-item" data-roles="housekeeping manager admin" href="#">Công việc buồng phòng</a><a class="nav-link role-menu-item" data-roles="accountant manager admin" href="#">Tài chính và báo cáo</a><span class="nav-label">HỆ THỐNG</span><a class="nav-link role-menu-item" data-roles="manager admin" href="#">Nhân viên</a><a class="nav-link role-menu-item" data-roles="admin" href="#">Phân quyền</a></nav><div class="sidebar-footer">● Hệ thống đang hoạt động<br /><small>v0.1.0</small></div></aside><main class="main-content"><header class="topbar"><div class="property-switcher"><span class="hotel-dot"></span><span><strong>Aurora Hotel</strong><small>Đà Nẵng, Việt Nam</small></span></div><div class="topbar-actions"><div class="profile"><span class="avatar" data-user-avatar>MA</span><span><strong data-user-name>Minh Anh</strong><small data-user-role>Manager</small></span></div><button class="logout-button" data-demo-logout type="button">Đăng xuất</button></div></header><div class="page-content">@RenderBody()</div></main></div><script src="~/js/role-demo.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
