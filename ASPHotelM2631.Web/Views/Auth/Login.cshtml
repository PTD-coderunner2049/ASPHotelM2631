@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<div class="auth-card"><div class="auth-heading"><p>CHÀO MỪNG TRỞ LẠI</p><h1>Đăng nhập</h1><span>Đăng nhập để quản lý Aurora Hotel.</span></div><form class="auth-form" data-login-form><label for="login-email">Email</label><input id="login-email" name="email" type="email" placeholder="name@hotel.com" required /><label for="login-password">Mật khẩu</label><input id="login-password" name="password" type="password" placeholder="Nhập mật khẩu" required /><label for="login-role">Vai trò demo</label><select id="login-role" name="role"><option value="manager">Manager</option><option value="admin">Admin</option><option value="accountant">Kế toán</option><option value="receptionist">Lễ tân</option><option value="housekeeping">Buồng phòng</option><option value="customer">Khách hàng</option></select><button class="auth-submit" type="submit">Đăng nhập</button><p class="auth-feedback" hidden role="status"></p></form><p class="auth-switch">Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register">Đăng ký ngay</a></p></div>
