@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng ký"; }
<div class="auth-card"><div class="auth-heading"><p>BẮT ĐẦU VỚI AURORA</p><h1>Tạo tài khoản</h1><span>Thiết lập giao diện tài khoản quản lý khách sạn.</span></div><form class="auth-form" data-register-form><label>Họ và tên</label><input name="fullName" placeholder="Nguyễn Minh Anh" required /><label>Email</label><input name="email" type="email" placeholder="name@hotel.com" required /><label>Mật khẩu</label><input name="password" type="password" placeholder="Tối thiểu 8 ký tự" required /><label>Xác nhận mật khẩu</label><input name="confirmPassword" type="password" placeholder="Nhập lại mật khẩu" required /><button class="auth-submit" type="submit">Tạo tài khoản</button><p class="auth-feedback" hidden role="status"></p></form><p class="auth-switch">Đã có tài khoản? <a asp-controller="Auth" asp-action="Login">Đăng nhập</a></p></div>
